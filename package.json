{
  "name": "@catronomix/opencode-modelrank",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "OpenCode plugin: rank Zen/Go models by benchmark score and real per-token price, with a /modelrank menu and a sidebar comparison.",
  "type": "module",
  "homepage": "https://github.com/catronomix/opencode-modelrank#readme",
  "bugs": {
    "url": "https://github.com/catronomix/opencode-modelrank/issues"
  },
  "license": "MIT",
  "author": "Innocent Coppieters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catronomix/opencode-modelrank.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "models",
    "benchmarks",
    "pricing",
    "zen",
    "go"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build && node scripts/release-check.mjs",
    "release-check": "node scripts/release-check.mjs",
    "test": "node --test test/logic.test.ts test/data.test.ts test/theme.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0 <3",
    "@opencode/theme": ">=2.3.2",
    "@opentui/core": ">=0.9.0",
    "@opentui/solid": ">=0.9.0",
    "solid-js": ">=1.9.0 <2"
  },
  "peerDependenciesMeta": {
    "@opencode/theme": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.3.2",
    "@opencode/theme": "2.3.2",
    "@opentui/core": "^0.9.7",
    "@opentui/solid": "^0.9.7",
    "@types/node": "^26.6.6",
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "^1.9.20",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.6"
  }
}
